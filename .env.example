# Supabase Backend Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Client-Side Security Gate PIN (4 digits)
VITE_APP_PIN=1234

# Google Gemini API Key (Optional fallback if gemini-proxy Edge Function is unconfigured)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Note: Server-side secrets must be configured via Supabase CLI or Dashboard:
# - APP_PIN_HASH="<sha256_hash_of_pin>"  (Required: Edge Functions fail-closed authentication)
# - GEMINI_API_KEY="<gemini_api_key>"     (Required: Server-side gemini-proxy key)
